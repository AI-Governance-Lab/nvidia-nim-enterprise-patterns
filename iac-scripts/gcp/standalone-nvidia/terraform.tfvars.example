# =============================================================================
# Terraform Variables Example for Standalone VM Deployment
# Copy this file to terraform.tfvars and fill in YOUR values
# terraform.tfvars is gitignored - never commit real values!
# =============================================================================

# Required: Your GCP Project ID
project_id = "your-gcp-project-id"

# Optional: Region and zone (must have GPU quota)
region = "us-central1"
zone   = "us-central1-a"

# Optional: GPU type (L4 or T4)
gpu_type = "L4"

# Optional: Use Spot VM for cost savings (true/false)
is_spot = true