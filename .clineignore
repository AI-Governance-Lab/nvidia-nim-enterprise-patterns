# ==========================================
# CLINE IGNORE FILE (.clineignore)
# Prevents Cline from scanning heavy or private files
# ==========================================

# Version Control
.git/
.gitignore
.svn/
.hg/

# OS/System files
.DS_Store
Thumbs.db

# Dependencies & Environments
node_modules/
bower_components/
.venv/
venv/
#env/
.env
.env.*
virtualenv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build & Output directories
dist/
build/
out/
bin/
obj/
.next/
.nuxt/
target/

# Databases & Local state (Very important! Prevents scanning huge SQLite databases)
*.db
*.db-journal
*.sqlite
*.sqlite3
webui.db
data/
open-webui-data/
podman-volumes/

# Sensitive Information & Credentials
credentials.json
*.pem
*.key
*.pfx
*.p12

# Cache & Temporary Directories
.cache/
.npm/
.eslintcache
tmp/
temp/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
