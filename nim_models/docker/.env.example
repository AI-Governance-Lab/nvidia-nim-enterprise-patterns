# =============================================================================
# NVIDIA NIM - Environment Configuration Template
# Copiaza acest fisier ca .env si completeaza cu cheia ta reala NGC API
# cp .env.example .env
# =============================================================================

# Cheia ta de acces NVIDIA GPU Cloud (NGC)
# Obtinuta de la: https://build.nvidia.com sau https://org.ngc.nvidia.com
NGC_API_KEY=nvapi-your-real-ngc-api-key-here

# Calea locala pe masina host pentru persistenta modelelor descarcate
LOCAL_NIM_CACHE=~/.cache/nim

# Portul expus pentru API-ul NIM (OpenAI-compatible)
NIM_PORT=8000

# Setari aditionale runtime GPU
NVIDIA_VISIBLE_DEVICES=all
